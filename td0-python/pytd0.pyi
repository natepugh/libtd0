from _typeshed import Incomplete
from collections.abc import Sequence
from typing import Any, Final, final

@final
class ChunkManifest:
    def __repr__(self, /) -> str: ...
    def __str__(self, /) -> str: ...
    @property
    def item_size(self, /) -> int: ...
    @property
    def name(self, /) -> str: ...
    @property
    def num_items(self, /) -> int: ...
    @property
    def pos(self, /) -> int: ...
    @property
    def size(self, /) -> int: ...

@final
class TD0BackupType:
    Kit: Final[TD0BackupType]
    System: Final[TD0BackupType]
    Unknown: Final[TD0BackupType]
    def __int__(self, /) -> int: ...
    def __repr__(self, /) -> str: ...

@final
class TD0ChunkItem:
    def field_options(self, /, field: str) -> list[str] |None: ...
    def field_type(self, /, field: str) -> TD0ValueType |None: ...
    def field_value(self, /, field: str) -> Incomplete: ...
    def field_value_raw(self, /, field: str) -> Incomplete: ...
    def list_fields(self, /) -> list[str]: ...
    def set_field_value(self, /, field: str, value: Any) -> None: ...
    def set_field_value_raw(self, /, field: str, value: Any) -> None: ...

@final
class TD0DeviceModel:
    SPDSXPro: Final[TD0DeviceModel]
    Unknown: Final[TD0DeviceModel]
    def __int__(self, /) -> int: ...
    def __repr__(self, /) -> str: ...

@final
class TD0File:
    def __new__(cls, /, data: Sequence[int] |None = None) -> TD0File: ...
    def add_chunk(self, /, chunk_name: str, num_items: int) -> None: ...
    def chunk_item_replace(self, /, chunk_name: str, item_index: int, source: TD0ChunkItem) -> None: ...
    def chunk_items_copy(self, /, chunk_name: str, source_index: int, dest_index: int) -> None: ...
    def chunk_items_reorder(self, /, chunk_name: str, new_order: Sequence[int]) -> None: ...
    def chunk_items_swap(self, /, chunk_name: str, index_1: int, index_2: int) -> None: ...
    def finalize(self, /) -> None: ...
    def get_chunk_item(self, /, chunk_name: str, item_index: int) -> TD0ChunkItem: ...
    def get_chunk_item_default(self, /, chunk_name: str) -> TD0ChunkItem |None: ...
    def list_chunks(self, /) -> list[str]: ...
    def manifest(self, /) -> TD0Manifest: ...
    def to_bytes(self, /) -> bytes: ...

@final
class TD0Manifest:
    def __repr__(self, /) -> str: ...
    def __str__(self, /) -> str: ...
    @property
    def backup_name(self, /) -> str: ...
    @property
    def backup_type(self, /) -> TD0BackupType: ...
    @property
    def checksum_actual(self, /) -> str: ...
    @property
    def checksum_calculated(self, /) -> str: ...
    @property
    def chunks(self, /) -> list[ChunkManifest]: ...
    @property
    def device_firmware_build(self, /) -> str: ...
    @property
    def device_firmware_version(self, /) -> str: ...
    @property
    def device_model(self, /) -> TD0DeviceModel: ...
    @property
    def device_serial(self, /) -> str: ...
    @property
    def size_actual(self, /) -> int: ...
    @property
    def size_calculated(self, /) -> int: ...

@final
class TD0ValueType:
    Bytes: Final[TD0ValueType]
    Decimal: Final[TD0ValueType]
    Int: Final[TD0ValueType]
    String: Final[TD0ValueType]
    def __int__(self, /) -> int: ...
    def __repr__(self, /) -> str: ...

@final
class TD0ValueTypeRaw:
    Bytes: Final[TD0ValueTypeRaw]
    Int16: Final[TD0ValueTypeRaw]
    Int8: Final[TD0ValueTypeRaw]
    UInt16: Final[TD0ValueTypeRaw]
    UInt32: Final[TD0ValueTypeRaw]
    UInt8: Final[TD0ValueTypeRaw]
    def __int__(self, /) -> int: ...
    def __repr__(self, /) -> str: ...
